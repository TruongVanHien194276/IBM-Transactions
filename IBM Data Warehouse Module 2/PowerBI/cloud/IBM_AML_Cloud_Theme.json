{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.156.json",
  "name": "IBM AML Cloud Professional",
  "dataColors": [
    "#2563EB",
    "#0891B2",
    "#0F766E",
    "#D97706",
    "#C93C4A",
    "#6D5BD0",
    "#64748B",
    "#15803D"
  ],
  "background": "#F3F5F8",
  "foreground": "#111827",
  "tableAccent": "#2563EB",
  "good": "#15803D",
  "neutral": "#D97706",
  "bad": "#C93C4A",
  "maximum": "#C93C4A",
  "center": "#D97706",
  "minimum": "#15803D",
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#202A3B"
              }
            },
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4E8EF"
              }
            },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 25,
            "color": {
              "solid": {
                "color": "#111827"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#687386"
              }
            }
          }
        ]
      }
    }
  },
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 25,
      "color": "#111827"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#202A3B"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#202A3B"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#596578"
    }
  }
}
